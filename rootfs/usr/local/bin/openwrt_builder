    -ath10k-firmware-qca9888-ct \
    ath10k-firmware-qca4019 \
    ath10k-firmware-qca9888 \
    -kmod-ath10k-ct \
    kmod-ath10k \
"
# Full hostapd/wpad with 802.11r (Fast Transition) support
_PKG_WPAD=" \
    -wpad-basic-mbedtls \
