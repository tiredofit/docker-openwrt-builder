FILES="/assets/openwrt"
DISABLED_SERVICES="dnsmasq firewall odhcpd"

_merge_files() {
    if [ -d /build-assets ] && [ "$(ls -A /build-assets 2>/dev/null)" ]; then
        local _merge_dir="/tmp/files-merged"
        rm -rf "${_merge_dir}"
        cp -a /assets/openwrt/. "${_merge_dir}/"
        cp -a /build-assets/. "${_merge_dir}/"
        echo "${_merge_dir}"
    else
        echo "/assets/openwrt"
    fi
}

# Core system utilities
_PKG_BASE=" \
    bash \
    curl \
    ethtool \
    iperf3 \
    luci \
    luci-app-watchcat \
    luci-ssl \
    nano \
    openssh-sftp-server \
    watchcat \
"
# Wifi Mesh
_PKG_MESH=" \
    batctl-full \
    kmod-batman-adv \
    luci-proto-batman-adv \
"

# ATH10K Drivers (Asus MAP)
